---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Portfolio from '../../components/Portfolio.astro';
import Reviews from '../../components/Reviews.astro';
import Pricing from '../../components/Pricing.astro';
import Process from '../../components/Process.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import WhyMe from '../../components/WhyMe.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import VideoModal from '../../components/VideoModal.astro';
import StickyMobileCta from '../../components/StickyMobileCta.astro';

import kzData from '../../data/kz.json';
import projectsData from '../../data/projects.json';
import reviewsData from '../../data/reviews.json';
import contactsData from '../../data/contacts.json';

import '../../styles/global.css';

const telegramContact = contactsData.find((c) => c.id === 'telegram') || contactsData[0];
---

<Layout
  title={kzData.meta.title}
  description={kzData.meta.description}
  lang="kz"
  canonicalUrl="https://fluere.work/kz/"
  ogTitle={kzData.meta.ogTitle}
  ogDescription={kzData.meta.ogDescription}
  ogImage={kzData.meta.ogImage}
>
  <Header lang="kz" nav={kzData.nav} />

  <main id="content">
    <Hero hero={kzData.hero} lang="kz" />
    <Portfolio data={kzData.portfolio} projects={projectsData} lang="kz" />
    <Reviews data={kzData.reviews} reviews={reviewsData} lang="kz" />
    <Pricing data={kzData.pricing} lang="kz" />
    <Process data={kzData.process} />
    <BeforeAfter data={kzData.theDifference} />
    <WhyMe data={kzData.whyMe} tools={kzData.tools} />
    <Faq data={kzData.faq} />
    <Contact data={kzData.contact} contacts={contactsData} lang="kz" />
  </main>

  <Footer data={kzData.footer} contacts={contactsData} lang="kz" />

  <!-- Lazy-loaded Video Player Modal -->
  <VideoModal />

  <!-- Mobile Sticky Telegram CTA Button -->
  <StickyMobileCta
    text={kzData.stickyMobile?.text || "Telegram-ға жазу"}
    telegramUrl={telegramContact.url}
  />
</Layout>
