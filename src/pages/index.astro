---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Portfolio from '../components/Portfolio.astro';
import Tools from '../components/Tools.astro';
import Reviews from '../components/Reviews.astro';
import Process from '../components/Process.astro';
import WhyMe from '../components/WhyMe.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import StickyMobileCta from '../components/StickyMobileCta.astro';

import enData from '../data/en.json';
import projectsData from '../data/projects.json';
import reviewsData from '../data/reviews.json';
import contactsData from '../data/contacts.json';

import '../styles/global.css';

const telegramContact = contactsData.find((c) => c.id === 'telegram') || contactsData[0];
---

<Layout
  title={enData.meta.title}
  description={enData.meta.description}
  lang="en"
  canonicalUrl="https://fluere.work/"
  ogTitle={enData.meta.ogTitle}
  ogDescription={enData.meta.ogDescription}
  ogImage={enData.meta.ogImage}
>
  <Header lang="en" nav={enData.nav} />

  <main id="content">
    <Hero hero={enData.hero} lang="en" />
    <BeforeAfter data={enData.theDifference} />
    <Portfolio data={enData.portfolio} projects={projectsData} lang="en" />
    <Tools data={enData.tools} />
    <Reviews data={enData.reviews} reviews={reviewsData} lang="en" />
    <Process data={enData.process} />
    <WhyMe data={enData.whyMe} />
    <Pricing data={enData.pricing} lang="en" />
    <Faq data={enData.faq} />
    <Contact data={enData.contact} contacts={contactsData} lang="en" />
  </main>

  <Footer data={enData.footer} contacts={contactsData} lang="en" />

  <!-- Lazy-loaded Video Player Modal -->
  <VideoModal />

  <!-- Mobile Sticky Telegram CTA Button -->
  <StickyMobileCta
    text={enData.stickyMobile?.text || "Message on Telegram"}
    telegramUrl={telegramContact.url}
  />
</Layout>
