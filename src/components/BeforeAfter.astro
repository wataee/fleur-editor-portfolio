---
interface Props {
  data: {
    eyebrow: string;
    title: string;
    description: string;
    before: string;
    after: string;
    playAria: string;
    handleAria: string;
    videoBefore: string;
    videoAfter: string;
    posterBefore: string;
    posterAfter: string;
  };
}

const { data } = Astro.props;
---

<section class="section section--ba" id="difference" aria-labelledby="ba-title">
  <div class="section-head">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="ba-title">{data.title}</h2>
  </div>

  <p class="sr-only">
    {data.description}
  </p>

  <div
    class="ba"
    id="ba-container"
    style="--ba-pos: 50%;"
  >
    <!-- Background layer: After video -->
    <video
      class="ba-video"
      id="ba-video-after"
      preload="none"
      muted
      loop
      playsinline
      tabindex="-1"
      aria-hidden="true"
      poster="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=1280&q=80"
    >
      <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
    </video>

    <!-- Clipped layer: Before video -->
    <div class="ba-clip" id="ba-clip">
      <video
        class="ba-video"
        id="ba-video-before"
        preload="none"
        muted
        loop
        playsinline
        tabindex="-1"
        aria-hidden="true"
        poster="https://images.unsplash.com/photo-1536240478700-b869070f9279?auto=format&fit=crop&w=1280&q=80"
      >
        <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Labels -->
    <span class="ba-label ba-label--before">{data.before}</span>
    <span class="ba-label ba-label--after">{data.after}</span>

    <!-- Draggable divider handle with accessibility slider role -->
    <div
      class="ba-handle"
      id="ba-handle"
      role="slider"
      tabindex="0"
      aria-label={data.handleAria}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-valuetext="50%"
    >
      <span class="ba-handle-grip" aria-hidden="true">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
        </svg>
      </span>
    </div>

    <!-- Play / Pause Toggle -->
    <button
      class="ba-toggle"
      id="ba-toggle-btn"
      type="button"
      aria-label={data.playAria}
    >
      <svg id="ba-icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5l11 7-11 7z"></path>
      </svg>
      <svg id="ba-icon-pause" class="hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  // Before / After Slider Logic
  const container = document.getElementById('ba-container');
  const handle = document.getElementById('ba-handle');
  const videoBefore = document.getElementById('ba-video-before') as HTMLVideoElement | null;
  const videoAfter = document.getElementById('ba-video-after') as HTMLVideoElement | null;
  const toggleBtn = document.getElementById('ba-toggle-btn');
  const iconPlay = document.getElementById('ba-icon-play');
  const iconPause = document.getElementById('ba-icon-pause');

  if (container && handle && videoBefore && videoAfter && toggleBtn) {
    let pos = 50;
    let isPlaying = false;
    let userPaused = false;
    let lastSyncTime = 0;
    const SYNC_INTERVAL = 1000; // ms
    const DRIFT_TOLERANCE = 0.15; // s

    const setPosition = (newPos: number) => {
      pos = Math.min(100, Math.max(0, newPos));
      container.style.setProperty('--ba-pos', `${pos}%`);
      handle.setAttribute('aria-valuenow', Math.round(pos).toString());
      handle.setAttribute('aria-valuetext', `${Math.round(pos)}%`);
    };

    // Calculate position from clientX
    const calcPosFromClientX = (clientX: number) => {
      const rect = container.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    };

    // Pointer events for smooth drag
    container.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.ba-toggle')) return;
      container.setPointerCapture(e.pointerId);
      setPosition(calcPosFromClientX(e.clientX));
    });

    container.addEventListener('pointermove', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        setPosition(calcPosFromClientX(e.clientX));
      }
    });

    container.addEventListener('pointerup', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        container.releasePointerCapture(e.pointerId);
      }
    });

    // Keyboard accessibility
    handle.addEventListener('keydown', (e) => {
      const step = 5;
      let newPos = pos;
      if (e.key === 'ArrowLeft') newPos -= step;
      else if (e.key === 'ArrowRight') newPos += step;
      else if (e.key === 'Home') newPos = 0;
      else if (e.key === 'End') newPos = 100;
      else return;

      e.preventDefault();
      setPosition(newPos);
    });

    // Synchronized playback controls
    const playBoth = async () => {
      try {
        await Promise.all([videoBefore.play(), videoAfter.play()]);
        isPlaying = true;
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
      } catch (err) {
        console.warn('Playback prevented', err);
      }
    };

    const pauseBoth = () => {
      videoBefore.pause();
      videoAfter.pause();
      isPlaying = false;
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
    };

    toggleBtn.addEventListener('click', () => {
      if (isPlaying) {
        userPaused = true;
        pauseBoth();
      } else {
        userPaused = false;
        playBoth();
      }
    });

    // Video sync check
    videoAfter.addEventListener('timeupdate', () => {
      const now = performance.now();
      if (now - lastSyncTime < SYNC_INTERVAL) return;
      lastSyncTime = now;

      if (!videoBefore.seeking && !videoAfter.seeking) {
        const drift = Math.abs(videoAfter.currentTime - videoBefore.currentTime);
        if (drift > DRIFT_TOLERANCE) {
          videoBefore.currentTime = videoAfter.currentTime;
        }
      }
    });

    // IntersectionObserver: Play only when in viewport (unless user paused or reduced motion)
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          if (!userPaused && !isPlaying) {
            playBoth();
          }
        } else {
          if (isPlaying) {
            pauseBoth();
          }
        }
      }, { threshold: 0.15 });

      observer.observe(container);
    }
  }
</script>
