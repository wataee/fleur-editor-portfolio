---
interface Props {
  data: {
    eyebrow: string;
    title: string;
    description: string;
    before: string;
    after: string;
    handleAria: string;
    posterBefore: string;
    posterAfter: string;
  };
}

const { data } = Astro.props;

// High quality cinema frame
const frameSource = data.posterAfter || "/videos/posters/vroomclub-reel.jpg";
---

<section class="section section--ba" id="difference" aria-labelledby="ba-title">
  <div class="section-head" data-reveal="true">
    <div class="inline-flex items-center gap-2">
      <span class="tape-index font-mono" aria-hidden="true">[COLOR // DAVINCI]</span>
      <span class="eyebrow">{data.eyebrow}</span>
    </div>
    <h2 class="section-title" id="ba-title">{data.title}</h2>
  </div>

  <p class="section-lead max-w-2xl text-text-dim text-sm sm:text-base mb-8" data-reveal="true">
    {data.description}
  </p>

  <!-- Interactive Comparison Frame -->
  <div
    class="ba-suite-wrapper"
    id="ba-container"
    style="--ba-pos: 50%;"
    data-reveal="true"
  >
    <!-- Top Monitor HUD Strip -->
    <div class="ba-monitor-bar font-mono text-[11px]" aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="ba-status-rec">● GRADED PREVIEW</span>
        <span class="text-text-mute">·</span>
        <span>DA VINCI RESOLVE STUDIO</span>
      </div>
      <div class="flex items-center gap-4 text-text-dim">
        <span>3840×2160 UHD</span>
        <span class="hidden sm:inline">10-BIT 4:2:2</span>
        <span class="text-accent">24.00 FPS</span>
      </div>
    </div>

    <!-- The Split Screen Container -->
    <div class="ba-viewport">
      <!-- Right/Under layer: Graded Rec.709 film profile -->
      <div class="ba-layer ba-layer--graded">
        <img
          class="ba-image"
          src={frameSource}
          alt=""
          loading="lazy"
          decoding="async"
          width="1920"
          height="1080"
        />
        <div class="ba-badge ba-badge--after">
          <span class="ba-badge-dot"></span>
          <span>{data.after}</span>
        </div>
        <div class="ba-hud-tag ba-hud-tag--right font-mono" aria-hidden="true">
          <span>TARGET: REC.709 · KODAK 2383 D65</span>
        </div>
      </div>

      <!-- Left layer: Clipped Raw S-Log3 profile -->
      <div class="ba-clip" id="ba-clip">
        <div class="ba-layer ba-layer--log">
          <img
            class="ba-image ba-image--slog"
            src={frameSource}
            alt=""
            loading="lazy"
            decoding="async"
            width="1920"
            height="1080"
          />
          <div class="ba-badge ba-badge--before">
            <span class="ba-badge-dot ba-badge-dot--raw"></span>
            <span>{data.before}</span>
          </div>
          <div class="ba-hud-tag ba-hud-tag--left font-mono" aria-hidden="true">
            <span>INPUT: SONY S-LOG3 / S-GAMUT3.CINE</span>
          </div>
        </div>
      </div>

      <!-- Interactive Scrub Handle -->
      <div
        class="ba-handle"
        id="ba-handle"
        role="slider"
        tabindex="0"
        aria-label={data.handleAria}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-valuetext="50%"
      >
        <div class="ba-handle-line"></div>
        <div class="ba-handle-grip" aria-hidden="true">
          <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
            <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Bottom Waveform / Metadata Strip -->
    <div class="ba-bottom-bar font-mono text-[11px]" aria-hidden="true">
      <div class="flex items-center gap-3 text-text-dim">
        <span class="text-accent">TC: 00:00:24:18</span>
        <span>SCOPE: RGB PARADE</span>
        <span class="hidden sm:inline">GAMMA: 2.4</span>
      </div>
      <div class="text-text-mute text-right">
        <span>DRAG TO REVEAL THE GRADE ↔</span>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('ba-container');
  const handle = document.getElementById('ba-handle');

  if (container && handle) {
    let pos = 50;

    const setPosition = (newPos: number) => {
      pos = Math.min(100, Math.max(0, newPos));
      container.style.setProperty('--ba-pos', `${pos}%`);
      handle.setAttribute('aria-valuenow', Math.round(pos).toString());
      handle.setAttribute('aria-valuetext', `${Math.round(pos)}%`);
    };

    const calcPosFromClientX = (clientX: number) => {
      const rect = container.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    };

    // Pointer events with full touch and desktop support
    let dragRaf: number | null = null;

    container.addEventListener('pointerdown', (e) => {
      container.setPointerCapture(e.pointerId);
      setPosition(calcPosFromClientX(e.clientX));
    });

    container.addEventListener('pointermove', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        const cx = e.clientX;
        if (dragRaf) cancelAnimationFrame(dragRaf);
        dragRaf = requestAnimationFrame(() => {
          setPosition(calcPosFromClientX(cx));
        });
      }
    });

    container.addEventListener('pointerup', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        container.releasePointerCapture(e.pointerId);
      }
      if (dragRaf) cancelAnimationFrame(dragRaf);
    });

    container.addEventListener('pointercancel', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        container.releasePointerCapture(e.pointerId);
      }
      if (dragRaf) cancelAnimationFrame(dragRaf);
    });

    // Keyboard support
    handle.addEventListener('keydown', (e) => {
      const step = 5;
      let newPos = pos;
      if (e.key === 'ArrowLeft') newPos -= step;
      else if (e.key === 'ArrowRight') newPos += step;
      else if (e.key === 'Home') newPos = 0;
      else if (e.key === 'End') newPos = 100;
      else return;

      e.preventDefault();
      setPosition(newPos);
    });
  }
</script>
