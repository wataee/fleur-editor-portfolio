---
interface Props {
  data: {
    eyebrow: string;
    title: string;
    description: string;
    before: string;
    after: string;
    handleAria: string;
    posterBefore: string;
    posterAfter: string;
  };
}

const { data } = Astro.props;
---

<section class="section section--ba" id="difference" aria-labelledby="ba-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="ba-title">{data.title}</h2>
  </div>

  <p class="sr-only">
    {data.description}
  </p>

  <div
    class="ba"
    id="ba-container"
    style="--ba-pos: 50%;"
    data-reveal="true"
  >
    <!-- Same source image on both sides; CSS shows a restrained neutral/graded comparison. -->
    <img
      class="ba-video ba-video--graded"
      src={data.posterAfter || data.posterBefore || "/og-image.png"}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />

    <!-- Clipped layer: Raw flat camera profile (S-Log3 / RAW) -->
    <div class="ba-clip" id="ba-clip">
      <img
        class="ba-video ba-video--log"
        src={data.posterBefore || data.posterAfter || "/og-image.png"}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Labels -->
    <span class="ba-label ba-label--before">{data.before}</span>
    <span class="ba-label ba-label--after">{data.after}</span>

    <!-- Draggable divider handle with accessibility slider role -->
    <div
      class="ba-handle"
      id="ba-handle"
      role="slider"
      tabindex="0"
      aria-label={data.handleAria}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-valuetext="50%"
    >
      <span class="ba-handle-grip" aria-hidden="true">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
        </svg>
      </span>
    </div>

  </div>
</section>

<script>
  // Before / After Slider Logic
  const container = document.getElementById('ba-container');
  const handle = document.getElementById('ba-handle');
  if (container && handle) {
    let pos = 50;

    const setPosition = (newPos: number) => {
      pos = Math.min(100, Math.max(0, newPos));
      container.style.setProperty('--ba-pos', `${pos}%`);
      handle.setAttribute('aria-valuenow', Math.round(pos).toString());
      handle.setAttribute('aria-valuetext', `${Math.round(pos)}%`);
    };

    // Calculate position from clientX
    const calcPosFromClientX = (clientX: number) => {
      const rect = container.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    };

    // Pointer events for ultra-smooth drag
    let dragRaf: number | null = null;
    container.addEventListener('pointerdown', (e) => {
      container.setPointerCapture(e.pointerId);
      setPosition(calcPosFromClientX(e.clientX));
    });

    container.addEventListener('pointermove', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        const cx = e.clientX;
        if (dragRaf) cancelAnimationFrame(dragRaf);
        dragRaf = requestAnimationFrame(() => {
          setPosition(calcPosFromClientX(cx));
        });
      }
    });

    container.addEventListener('pointerup', (e) => {
      if (container.hasPointerCapture(e.pointerId)) {
        container.releasePointerCapture(e.pointerId);
      }
      if (dragRaf) cancelAnimationFrame(dragRaf);
    });
    container.addEventListener('pointercancel', (e) => {
      if (container.hasPointerCapture(e.pointerId)) container.releasePointerCapture(e.pointerId);
      if (dragRaf) cancelAnimationFrame(dragRaf);
    });

    // Keyboard accessibility
    handle.addEventListener('keydown', (e) => {
      const step = 5;
      let newPos = pos;
      if (e.key === 'ArrowLeft') newPos -= step;
      else if (e.key === 'ArrowRight') newPos += step;
      else if (e.key === 'Home') newPos = 0;
      else if (e.key === 'End') newPos = 100;
      else return;

      e.preventDefault();
      setPosition(newPos);
    });

  }
</script>
