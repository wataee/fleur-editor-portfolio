---
interface Plan {
  name: string;
  price: string;
  description: string;
  badge: string | null;
  features: string[];
  published?: boolean;
}

interface Props {
  data: {
    eyebrow: string;
    title: string;
    plans: Plan[];
    cta: string;
  };
  lang?: string;
}

const { data, lang = 'ru' } = Astro.props;

// Filter out unpublished or placeholder plans (e.g. [TODO] Reels pricing)
const visiblePlans = data.plans.filter((p) => p.published !== false && !p.price.includes('[TODO]'));
---

<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="pricing-title">{data.title}</h2>
  </div>

  <div class="pricing-grid">
    {visiblePlans.map((plan) => (
      <div class="pricing-card" data-reveal="card">
        <div class="pricing-card-header">
          <div class="pricing-card-top">
            <h3 class="pricing-name">{plan.name}</h3>
            {plan.badge && (
              <span class="pricing-badge">{plan.badge}</span>
            )}
          </div>
          <p class={`pricing-price ${plan.price.length > 8 ? 'pricing-price--custom' : ''}`}>{plan.price}</p>
          <p class="pricing-desc">{plan.description}</p>
        </div>

        <ul class="pricing-features">
          {plan.features.map((feature) => (
            <li class="pricing-feature">
              <svg class="w-4 h-4 pricing-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <div class="pt-2">
          <a class="btn-primary w-full text-center" href="#contact">
            {data.cta}
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
