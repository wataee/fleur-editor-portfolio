---
interface Item {
  id?: string;
  title: string;
  desc?: string;
  body?: string;
}

interface Tool {
  name: string;
  category?: string;
  badge?: string;
}

interface Props {
  data: {
    eyebrow: string;
    title: string;
    items: Item[];
  };
  tools?: {
    eyebrow?: string;
    title?: string;
    items: Tool[];
  };
}

const { data, tools } = Astro.props;
const toolItems = tools?.items ? tools.items.filter((item) => item.name !== 'Blender') : [];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="about-title">{data.title}</h2>
  </div>

  <div class="why-grid">
    {data.items.map((item, index) => (
      <div class="why-item" id={item.id ? `why-${item.id}` : undefined} data-reveal="card">
        <div class="why-item-topline">
          <span class="why-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="why-marker" aria-hidden="true">✳</span>
        </div>
        <h3 class="why-title">{item.title}</h3>
        <p class="why-body">{item.desc || item.body}</p>
      </div>
    ))}
  </div>

  {toolItems.length > 0 && (
    <div class="why-tools-wrap mt-12" data-reveal="true">
      <div class="tools-strip">
        <div class="tools-strip-label">
          <span class="tools-indicator" aria-hidden="true"></span>
          <span class="tools-label-text">{tools?.title || "Рабочий стек"}</span>
        </div>
        <div class="tools-strip-divider" aria-hidden="true"></div>
        <div class="tools-strip-items" role="list">
          {toolItems.map((tool) => (
            <div class="tool-strip-pill" role="listitem">
              <div class="tool-strip-icon" aria-hidden="true">
                {tool.name === 'Premiere Pro' && (
                  <svg class="w-7 h-7" viewBox="0 0 32 32" fill="none">
                    <rect width="32" height="32" rx="7" fill="#00005B" />
                    <rect x="0.5" y="0.5" width="31" height="31" rx="6.5" stroke="#9999FF" stroke-opacity="0.35" />
                    <path d="M8.5 21.5V10.5h4.8c1.6 0 2.8.3 3.6 1 .8.6 1.2 1.6 1.2 2.7 0 1.2-.4 2.1-1.2 2.8-.8.6-2 1-3.6 1h-2.3v3.5H8.5zm2.5-6h2.1c.9 0 1.6-.2 2-.5.5-.4.7-.9.7-1.6 0-.7-.2-1.2-.7-1.5-.4-.4-1.1-.5-2-.5H11v4.1z" fill="#9999FF" />
                    <path d="M19.5 14h2.2v1.4c.4-.6.8-1 1.3-1.2.5-.3 1-.4 1.7-.4v2.5c-.3 0-.6 0-.8.1-.5.1-.9.3-1.3.7-.3.4-.6.9-.6 1.6v3.3h-2.5V14z" fill="#9999FF" />
                  </svg>
                )}
                {tool.name === 'After Effects' && (
                  <svg class="w-7 h-7" viewBox="0 0 32 32" fill="none">
                    <rect width="32" height="32" rx="7" fill="#00005B" />
                    <rect x="0.5" y="0.5" width="31" height="31" rx="6.5" stroke="#D291FF" stroke-opacity="0.35" />
                    <path d="M7.8 21.5l3.4-11h2.5l3.4 11h-2.4l-.8-2.8H11l-.8 2.8H7.8zm3.3-4.7h2.2l-1.1-4-1.1 4z" fill="#D291FF" />
                    <path d="M19.4 17.3c.1.9.4 1.5.9 1.9.6.5 1.3.7 2.1.7 1 0 1.8-.3 2.5-.8l1.1 1.4c-1 1-2.2 1.4-3.7 1.4-1.6 0-2.8-.5-3.8-1.5-.9-1-1.4-2.3-1.4-3.9 0-1.7.5-3 1.4-4 .9-1 2.2-1.5 3.7-1.5 1.5 0 2.7.5 3.6 1.4.8 1 1.2 2.3 1.2 4v.2h-7.5zm5.3-1.7c-.1-.8-.3-1.3-.7-1.6-.4-.4-.9-.6-1.6-.6-.7 0-1.2.2-1.6.6-.4.4-.7.9-.8 1.6h4.7z" fill="#D291FF" />
                  </svg>
                )}
                {tool.name === 'DaVinci Resolve' && (
                  <svg class="w-7 h-7" viewBox="0 0 32 32" fill="none">
                    <defs>
                      <linearGradient id="dvr-red-wm" x1="12" y1="4" x2="12" y2="13" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#FF5252" />
                        <stop offset="100%" stop-color="#D32F2F" />
                      </linearGradient>
                      <linearGradient id="dvr-blue-wm" x1="13" y1="12" x2="20" y2="19" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#42A5F5" />
                        <stop offset="100%" stop-color="#1565C0" />
                      </linearGradient>
                      <linearGradient id="dvr-yellow-wm" x1="5" y1="12" x2="12" y2="19" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#FFEE58" />
                        <stop offset="100%" stop-color="#F57F17" />
                      </linearGradient>
                    </defs>
                    <rect width="32" height="32" rx="7" fill="#12161F" />
                    <rect x="0.5" y="0.5" width="31" height="31" rx="6.5" stroke="rgba(255, 255, 255, 0.16)" />
                    <g transform="translate(16, 16) scale(1.18) translate(-12, -12)">
                      <path d="M11.961 4.353c-1.976.089-3.204 1.658-3.214 3.29.019 1.443 1.635 3.481 2.884 4.53.12.099.154.109.33.18.062.025.198-.047.327-.135.36-.245.993-.947 1.648-1.738a7.67 7.67 0 0 0 1.031-1.683c.409-.89.261-1.599.235-1.888a3.983 3.983 0 0 0-.99-1.692 3.36 3.36 0 0 0-2.251-.864z" fill="url(#dvr-red-wm)" />
                      <path d="M16.133 12.275a10.185 10.185 0 0 0-3.244.61c-.15.058-.26.1-.374.17-.057.036-.11.135-.105.292.017.433.29 1.278.624 2.27.384 1.135 1.066 2.27 1.844 2.74a3.23 3.23 0 0 0 2.53.342c.832-.243 1.595-.868 1.962-1.546.986-1.818.19-3.548-1.121-4.417-.447-.296-1.133-.445-1.89-.46-.074 0-.15-.002-.226-.001z" fill="url(#dvr-blue-wm)" />
                      <path d="M7.701 12.313a6.201 6.201 0 0 0-.752.047c-.596.078-.932.273-1.29.51a3.177 3.177 0 0 0-1.365 1.979c-.075.552-.086 1.053.033 1.507.433 1.389 1.326 2.222 2.847 2.452.636.028 1.37-.063 1.99-.45 1.269-.782 2.08-3.17 2.412-4.742.053-.176.035-.357-.013-.42-.005-.067-.044-.113-.19-.183-.398-.192-1.32-.417-2.375-.6a7.68 7.68 0 0 0-1.297-.1z" fill="url(#dvr-yellow-wm)" />
                    </g>
                  </svg>
                )}
              </div>
              <div class="tool-strip-info">
                <span class="tool-strip-name">{tool.name}</span>
                {tool.category && <span class="tool-strip-category">{tool.category}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</section>
