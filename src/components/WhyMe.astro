---
interface Item {
  num: string;
  title: string;
  desc: string;
}

interface Props {
  data: {
    eyebrow: string;
    title: string;
    items: Item[];
  };
}

const { data } = Astro.props;
---

<section class="section section--why" id="about" aria-labelledby="about-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="about-title">{data.title}</h2>
  </div>

  <div class="why-grid">
    {data.items.map((item) => (
      <div class="why-item" data-reveal="card">
        <div class="why-item-topline">
          <span class="why-index font-mono">{item.num}</span>
        </div>
        <h3 class="why-title">{item.title}</h3>
        <p class="why-body">{item.desc}</p>
      </div>
    ))}
  </div>
</section>
