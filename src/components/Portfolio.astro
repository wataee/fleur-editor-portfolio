---
interface Project {
  id: string;
  type: 'video' | 'motion' | 'vertical';
  niche: string;
  video_path: string;
  poster_path: string;
  client_ru: string; client_en: string; client_kz?: string;
  format_ru: string; format_en: string; format_kz?: string;
  duration: string;
  title_ru: string; title_en: string; title_kz?: string;
  body_ru: string; body_en: string; body_kz?: string;
}
interface Props {
  data: {
    eyebrow: string; title: string; filterAll: string; niches: Record<string, string>;
    conceptLabel: string;
    subsections: { main: string; motion: string; vertical: string };
  };
  projects: Project[]; lang?: string;
}
const { data, projects, lang = 'ru' } = Astro.props;
const groups = [
  { type: 'video', title: data.subsections.main, ratio: '16:9 · LONG-FORM' },
  { type: 'vertical', title: data.subsections.vertical, ratio: '9:16 · SHORT-FORM' },
];
const field = (project: Project, key: 'title' | 'client' | 'format' | 'body') => {
  const suffix = lang === 'kz' ? 'kz' : lang === 'en' ? 'en' : 'ru';
  const value = project[`${key}_${suffix}` as keyof Project];
  const fallback = project[`${key}_ru` as keyof Project];
  return typeof value === 'string' && value ? value : fallback;
};
---

<section class="section section--work" id="work" aria-labelledby="work-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="work-title">{data.title}</h2>
  </div>
  <div class="work-tabs" role="tablist" aria-label={lang === 'kz' ? 'Бейне түрі бойынша сүзу' : lang === 'en' ? 'Filter videos by niche' : 'Фильтр видео по нишам'} data-reveal="true">
    {Object.entries(data.niches).map(([key, label], idx) => (
      <button type="button" role="tab" class={`work-tab ${idx === 0 ? 'active' : ''}`} id={`tab-${key}`} aria-selected={idx === 0 ? 'true' : 'false'} aria-controls="portfolio-grids" data-niche-filter={key}>{label}</button>
    ))}
  </div>
  <div id="portfolio-grids" class="portfolio-groups">
    {groups.map((group) => {
      const groupProjects = projects.filter((project) => project.type === group.type);
      if (!groupProjects.length) return null;
      return (
        <section class="portfolio-subsection" aria-label={group.title}>
          <div class="portfolio-subhead">
            <h3>{group.title}</h3><span>{group.ratio}</span>
          </div>
          <div class={`work-grid ${group.type === 'vertical' ? 'work-grid--vertical' : ''}`}>
            {groupProjects.map((project) => (
              <article class="work-card" data-niche={project.niche} data-type={project.type} data-reveal="card">
                <div class={`work-video-frame ${group.type === 'vertical' ? 'work-video-frame--portrait' : ''}`}>
                  <video controls playsinline preload="none" poster={project.poster_path} aria-label={field(project, 'title')}>
                    <source src={project.video_path} type="video/mp4" />
                  </video>
                </div>
                <h4 class="work-title">{field(project, 'title')}</h4>
                <p class="work-meta"><span class="work-client">{field(project, 'client')}</span><span>{field(project, 'format')}</span><span>{project.duration}</span><span class="text-accent">{data.niches[project.niche] || project.niche}</span></p>
                <p class="work-text">{field(project, 'body')}</p>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-niche-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.work-card');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const selected = tab.dataset.nicheFilter;
    tabs.forEach((item) => {
      const active = item === tab;
      item.setAttribute('aria-selected', String(active));
      item.classList.toggle('active', active);
    });
    cards.forEach((card) => {
      const match = selected === 'all' || card.dataset.niche === selected;
      card.style.display = match ? 'flex' : 'none';
      if (match) {
        card.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 260, easing: 'cubic-bezier(.22,.61,.36,1)' });
      }
    });
  }));
</script>
