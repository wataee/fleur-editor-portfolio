---
interface ContactChannel {
  id: string;
  name: string;
  handle: string;
  url: string;
  description_ru: string;
  description_en: string;
  description_kz?: string;
  primary: boolean;
}

interface Props {
  data: {
    eyebrow: string;
    title: string;
    sub: string;
    briefHelper?: string;
  };
  contacts: ContactChannel[];
  lang?: string;
}

const { data, contacts, lang = 'ru' } = Astro.props;

const tgMessage = lang === 'kz'
  ? "Сәлеметсіз бе! YouTube немесе әлеуметтік желіге бейнемонтаж қажет."
  : lang === 'en'
  ? "Hi! I need video editing for YouTube/socials. Let's discuss."
  : "Привет! Нужен монтаж видео для YouTube/соцсетей. Расскажу о проекте:";

const tgUrl = `https://t.me/ffluere?text=${encodeURIComponent(tgMessage)}`;

const mailSubject = lang === 'kz'
  ? "Бейнемонтаж бойынша сұраныс (.fleur)"
  : lang === 'en'
  ? "Video Editing Project Inquiry (.fleur)"
  : "Заказ монтажа видео (.fleur)";

const mailUrl = `mailto:fluere.work@gmail.com?subject=${encodeURIComponent(mailSubject)}`;

const tgDesc = lang === 'kz'
  ? "1–2 сағат ішінде жылдам жауап · Негізгі байланыс"
  : lang === 'en'
  ? "Fast reply within 1–2 hours · Primary channel"
  : "Быстрый ответ в течение 1–2 часов · Основной канал";

const emailDesc = lang === 'kz'
  ? "Толық техникалық тапсырма мен келісімшарттар үшін"
  : lang === 'en'
  ? "For detailed briefs and contracts"
  : "Для подробных ТЗ и договоров";

const briefTitle = lang === 'kz'
  ? "Бағасын жылдам есептеу үшін:"
  : lang === 'en'
  ? "For a quick estimate, please share:"
  : "Что прислать для быстрой оценки:";
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="contact-layout">
    <div class="contact-intro">
      <div class="contact-head" data-reveal="true">
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="section-title" id="contact-title">{data.title}</h2>
        <p class="text-text-dim text-base md:text-lg max-w-xl">
          {data.sub}
        </p>
      </div>
    </div>

    <!-- 2 Actionable Cards: Telegram (Primary Focus) and Email (Backup) -->
    <ul class="contact-cards">
      <!-- 1. Telegram Card -->
      <li data-reveal="card">
        <a
          class="contact-card card--interactive border-accent bg-accent-soft/20 shadow-glow"
          href={tgUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"></path>
            </svg>
          </span>

          <span class="contact-card-label">Telegram</span>
          <p class="contact-card-value">@ffluere</p>
          <p class="contact-card-desc">{tgDesc}</p>

          {data.briefHelper && (
            <div class="contact-brief-helper mt-3">
              <strong>{briefTitle}</strong>
              <span>{data.briefHelper}</span>
            </div>
          )}
        </a>
      </li>

      <!-- 2. Email Card -->
      <li data-reveal="card">
        <a
          class="contact-card card--interactive"
          href={mailUrl}
        >
          <span class="contact-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 6.5A1.5 1.5 0 014.5 5h15A1.5 1.5 0 0121 6.5v11a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 17.5v-11zm1.8.5l7.2 5.3L19.2 7H4.8z"></path>
            </svg>
          </span>

          <span class="contact-card-label">Email</span>
          <p class="contact-card-value">fluere.work@gmail.com</p>
          <p class="contact-card-desc">{emailDesc}</p>
        </a>
      </li>
    </ul>
  </div>
</section>
