---
interface Props {
  data: { eyebrow: string; title: string; sub?: string; demoLabel: string };
  reviews: Array<{
    id: string; initials: string; channel: string;
    name_ru: string; name_en: string; name_kz: string;
    role_ru: string; role_en: string; role_kz: string;
    quote_ru: string; quote_en: string; quote_kz: string;
  }>;
  lang?: string;
}
const { data, reviews, lang = 'ru' } = Astro.props;
---
<section class="section section--testimonials" id="reviews" aria-labelledby="testimonials-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="testimonials-title">{data.title}</h2>
    {data.sub && <p class="section-sub text-text-dim text-sm mt-1">{data.sub}</p>}
  </div>
  <div class="demo-review-grid">
    {reviews.map((review) => {
      const suffix = lang === 'kz' ? 'kz' : lang === 'en' ? 'en' : 'ru';
      return (
        <article class="demo-review-card" data-reveal="card">
          <span class="demo-review-label">{data.demoLabel}</span>
          <div class="demo-review-person">
            <span class="demo-review-avatar" aria-hidden="true">{review.initials}</span>
            <div><h3>{review[`name_${suffix}`]}</h3><p>{review.channel} · {review[`role_${suffix}`]}</p></div>
          </div>
          <blockquote>“{review[`quote_${suffix}`]}”</blockquote>
        </article>
      );
    })}
  </div>
</section>
