---
interface ContactChannel {
  id: string;
  name: string;
  handle: string;
  url: string;
}

interface Props {
  data: {
    copy: string;
    top?: string;
    toTop?: string;
  };
  contacts: ContactChannel[];
  lang?: string;
}

const { data, contacts, lang = 'ru' } = Astro.props;
const homeHref = lang === 'ru' ? '/ru/#top' : lang === 'kz' ? '/kz/#top' : '/#top';
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="wordmark" href={homeHref} aria-label="fleur Home">
      <img
        src="/avatar.jpg"
        alt="fleur"
        class="wordmark-avatar"
        width="28"
        height="28"
        loading="lazy"
      />
      <span class="wordmark-text">fleur</span>
    </a>

    <nav class="footer-nav" aria-label="Social links">
      {contacts.map((c) => (
        <a
          class="footer-link"
          href={c.url}
          target={c.url.startsWith('mailto:') ? '_self' : '_blank'}
          rel={c.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        >
          {c.name}
        </a>
      ))}
    </nav>

    <div class="footer-motion-wrap">
      <button
        type="button"
        id="motion-toggle-footer"
        class="footer-motion-btn"
        aria-label={lang === 'kz' ? 'Анимацияларды басқару' : lang === 'ru' ? 'Управление анимацией' : 'Toggle animations'}
        title="Toggle motion effects"
      >
        <span class="motion-dot" aria-hidden="true"></span>
        <span class="font-mono text-xs">FX: <span class="motion-state-text">ON</span></span>
      </button>
    </div>

    <span class="footer-copy">{data.copy}</span>
  </div>
</footer>