---
// VideoModal.astro - Modern Web Guidance Compliant Accessible Video Dialog
---

<dialog
  id="video-modal"
  class="video-modal"
  aria-modal="true"
  closedby="any"
>
  <div class="video-modal-wrapper" id="video-modal-wrapper">
    <!-- Header bar with ONLY close button (all unreadable text removed) -->
    <div class="video-modal-bar">
      <button
        type="button"
        class="video-modal-close"
        id="video-modal-close"
        aria-label="Закрыть (Esc)"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Video Stage: dynamic aspect ratio container for 16:9 or 9:16 -->
    <div class="video-modal-stage">
      <div id="video-modal-player-container" class="video-modal-container" data-orientation="horizontal">
        <!-- YouTube iframe injected ONLY upon user trigger -->
      </div>
    </div>
  </div>
</dialog>

<script>
  let lastActiveElement: HTMLElement | null = null;

  function getModalElements() {
    const dialog = document.getElementById('video-modal') as HTMLDialogElement | null;
    const wrapper = document.getElementById('video-modal-wrapper');
    const container = document.getElementById('video-modal-player-container');
    const closeBtn = document.getElementById('video-modal-close');
    return { dialog, wrapper, container, closeBtn };
  }

  function openVideoModal(videoId: string, orientation: string, title: string, trigger?: HTMLElement) {
    const { dialog, container, closeBtn } = getModalElements();
    if (!dialog || !container) return;

    if (trigger) lastActiveElement = trigger;

    container.setAttribute('data-orientation', orientation);

    container.innerHTML = `
      <iframe
        class="video-modal-iframe"
        src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0&modestbranding=1&playsinline=1"
        title="${title.replace(/"/g, '&quot;')}"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="eager"
      ></iframe>
    `;

    if (typeof dialog.showModal === 'function') {
      try {
        dialog.showModal();
      } catch (err) {
        dialog.setAttribute('open', '');
      }
    } else {
      dialog.setAttribute('open', '');
    }

    window.dispatchEvent(new CustomEvent('fleur:modal-open'));
    closeBtn?.focus();
  }

  function closeVideoModal() {
    const { dialog, container } = getModalElements();
    if (!dialog || !container) return;

    if (typeof dialog.close === 'function') {
      try {
        dialog.close();
      } catch (err) {
        dialog.removeAttribute('open');
      }
    } else {
      dialog.removeAttribute('open');
    }

    window.dispatchEvent(new CustomEvent('fleur:modal-close'));
    container.innerHTML = '';

    if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
      lastActiveElement.focus();
      lastActiveElement = null;
    }
  }

  // Global event delegation (works across client-side page transitions)
  if (!(window as any).__fleurVideoModalInit) {
    (window as any).__fleurVideoModalInit = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Close button
      if (target.closest('#video-modal-close')) {
        e.preventDefault();
        closeVideoModal();
        return;
      }

      // Video trigger button
      const trigger = target.closest('[data-video-id]') as HTMLElement | null;
      if (trigger) {
        e.preventDefault();
        const videoId = trigger.getAttribute('data-video-id');
        const orientation = trigger.getAttribute('data-orientation') || 'horizontal';
        const title = trigger.getAttribute('data-video-title') || 'Video Preview';
        if (videoId) {
          openVideoModal(videoId, orientation, title, trigger);
        }
        return;
      }

      // Backdrop click (clicking on dialog itself, outside wrapper)
      const { dialog } = getModalElements();
      if (dialog && dialog.open && target === dialog) {
        closeVideoModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const { dialog } = getModalElements();
        if (dialog && (dialog.open || dialog.hasAttribute('open'))) {
          e.preventDefault();
          closeVideoModal();
        }
      }
    });

    // Native cancel event
    document.addEventListener('cancel', (e) => {
      const { dialog } = getModalElements();
      if (e.target === dialog) {
        e.preventDefault();
        closeVideoModal();
      }
    }, true);
  }
</script>
