---
interface Props {
  hero: {
    status: string;
    title: string;
    sub: string;
    cta: string;
    ctaTg?: string;
  };
  lang?: string;
}

const { hero, lang = 'ru' } = Astro.props;

const tgPrefillMessage = lang === 'kz'
  ? "Сәлеметсіз бе! YouTube немесе әлеуметтік желіге бейнемонтаж қажет."
  : lang === 'en'
  ? "Hi! I need video editing for YouTube/socials."
  : "Привет! Нужен монтаж видео для YouTube/соцсетей. Расскажу о проекте:";

const tgUrl = `https://t.me/ffluere?text=${encodeURIComponent(tgPrefillMessage)}`;
const htmlLang = lang === 'kz' ? 'kk' : lang;
---

<section class="hero" aria-label="Introduction">
  <!-- Top Meta Strip -->
  <div class="hero-topline" data-reveal="true">
    <div class="hero-status">
      <span class="status-pulse" aria-hidden="true"></span>
      <span class="font-mono text-xs uppercase tracking-wider">{hero.status}</span>
    </div>
  </div>

  <!-- Main Headline -->
  <div class="hero-headline-wrap">
    <h1 class="hero-title" lang={htmlLang} data-reveal="true">
      {hero.title}
    </h1>
  </div>

  <!-- Hero Content: Left Text & CTA -->
  <div class="hero-content-grid">
    <div class="hero-lead-col">
      <p class="hero-sub" data-reveal="true">
        {hero.sub}
      </p>

      <div class="hero-actions" data-reveal="true">
        <a class="btn-primary" href="#work">
          <span>{hero.cta}</span>
          <svg class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          class="btn-secondary btn-secondary--telegram"
          href={tgUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"></path>
          </svg>
          <span>{hero.ctaTg || (lang === 'kz' ? 'Telegram-ға жазу' : lang === 'en' ? 'Message on Telegram' : 'Написать в Telegram')}</span>
        </a>
      </div>
    </div>
  </div>
</section>
