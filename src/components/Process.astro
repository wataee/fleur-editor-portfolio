---
interface Step {
  num: string;
  period: string;
  title: string;
  desc: string;
}

interface Props {
  data: {
    eyebrow: string;
    title: string;
    steps: Step[];
  };
}

const { data } = Astro.props;
---

<section class="section" id="process" aria-labelledby="process-title">
  <div class="section-head" data-reveal="true">
    <span class="eyebrow">{data.eyebrow}</span>
    <h2 class="section-title" id="process-title">{data.title}</h2>
  </div>

  <ol class="process-list" role="list">
    {data.steps.map((step) => (
      <li class="process-step" data-reveal="card">
        <div class="step-topline">
          <span class="step-tc">{step.num}</span>
          <span class="step-period">{step.period}</span>
        </div>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-body">{step.desc}</p>
        <span class="step-progress" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
</section>
