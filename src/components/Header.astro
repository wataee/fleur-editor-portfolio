---
interface NavData {
  work: string;
  difference?: string;
  process: string;
  about: string;
  pricing?: string;
  faq?: string;
  contact: string;
  discuss: string;
  openMenu: string;
}

interface Props {
  lang: 'ru' | 'en' | 'kz' | string;
  nav: NavData;
}

const { lang, nav } = Astro.props;
const homeHref = lang === 'ru' ? '/ru/#top' : lang === 'kz' ? '/kz/#top' : '/#top';
---

<header class="site-header" id="top">
  <div class="header-inner">
    <!-- Brand Wordmark with User Avatar -->
    <a class="wordmark" href={homeHref} aria-label="fleur Home">
      <img
        src="/avatar.jpg"
        alt="fleur"
        class="wordmark-avatar"
        width="32"
        height="32"
        loading="eager"
      />
      <span class="wordmark-text">fleur</span>
    </a>

    <!-- Desktop Navigation (<= 6 items matching page flow) -->
    <nav class="site-nav" aria-label="Main Navigation">
      <a class="nav-link" href="#work">{nav.work}</a>
      <a class="nav-link" href="#pricing">{nav.pricing || (lang === 'kz' ? 'Бағалар' : lang === 'en' ? 'Pricing' : 'Цены')}</a>
      <a class="nav-link" href="#process">{nav.process}</a>
      <a class="nav-link" href="#difference">{nav.difference || (lang === 'kz' ? 'Түс' : lang === 'en' ? 'Color' : 'Цвет')}</a>
      <a class="nav-link" href="#about">{nav.about}</a>
      <a class="nav-link" href="#contact">{nav.contact}</a>
    </nav>

    <div class="header-actions">
      <!-- Dark / Light Theme Toggle -->
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle dark/light theme"
        title="Toggle dark/light theme"
      >
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>

      <!-- Motion Toggle (Animations ON / OFF) -->
      <button
        type="button"
        id="motion-toggle"
        class="motion-toggle"
        aria-label="Toggle animations (FX)"
        title="Toggle animations (FX)"
      >
        <span class="motion-dot" aria-hidden="true"></span>
        <span class="motion-label font-mono">FX</span>
      </button>

      <!-- 3-Language Switcher (RU / EN / KZ) -->
      <div class="lang-switch" role="group" aria-label="Language switch">
        <a
          class="lang-btn"
          href="/ru/"
          aria-current={lang === 'ru' ? 'true' : 'false'}
        >
          RU
        </a>
        <span class="lang-sep" aria-hidden="true">/</span>
        <a
          class="lang-btn"
          href="/"
          aria-current={lang === 'en' ? 'true' : 'false'}
        >
          EN
        </a>
        <span class="lang-sep" aria-hidden="true">/</span>
        <a
          class="lang-btn"
          href="/kz/"
          aria-current={lang === 'kz' ? 'true' : 'false'}
        >
          KZ
        </a>
      </div>

      <a class="btn-primary header-cta" href="#contact">
        {nav.discuss}
      </a>
    </div>

    <!-- Mobile Navigation Drawer -->
    <details class="nav-toggle" id="mobile-nav-toggle">
      <summary aria-label={nav.openMenu} aria-expanded="false" aria-controls="nav-panel">
        <span class="nav-burger" aria-hidden="true"></span>
      </summary>
      <div class="nav-panel" id="nav-panel" role="region" aria-label={nav.openMenu}>
        <nav class="nav-panel-links">
          <a class="nav-panel-link" href="#work">{nav.work}</a>
          <a class="nav-panel-link" href="#pricing">{nav.pricing || (lang === 'kz' ? 'Бағалар' : lang === 'en' ? 'Pricing' : 'Цены')}</a>
          <a class="nav-panel-link" href="#process">{nav.process}</a>
          <a class="nav-panel-link" href="#difference">{nav.difference || (lang === 'kz' ? 'Түс' : lang === 'en' ? 'Color' : 'Цвет')}</a>
          <a class="nav-panel-link" href="#about">{nav.about}</a>
          <a class="nav-panel-link" href="#contact">{nav.contact}</a>
        </nav>
        <div class="nav-panel-foot">
          <div class="flex items-center justify-between w-full pb-2">
            <div class="lang-switch">
              <a class="lang-btn" href="/ru/" aria-current={lang === 'ru' ? 'true' : 'false'}>RU</a>
              <span class="lang-sep" aria-hidden="true">/</span>
              <a class="lang-btn" href="/" aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
              <span class="lang-sep" aria-hidden="true">/</span>
              <a class="lang-btn" href="/kz/" aria-current={lang === 'kz' ? 'true' : 'false'}>KZ</a>
            </div>

            <div class="flex items-center gap-2">
              <!-- Mobile Motion Toggle -->
              <button
                type="button"
                id="motion-toggle-mobile"
                class="motion-toggle"
                aria-label="Toggle animations (FX)"
                title="Toggle animations (FX)"
              >
                <span class="motion-dot" aria-hidden="true"></span>
                <span class="motion-label font-mono">FX</span>
              </button>

              <!-- Mobile Theme Toggle -->
              <button
                type="button"
                id="theme-toggle-mobile"
                class="theme-toggle"
                aria-label="Toggle dark/light theme"
              >
                <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="5"></circle>
                  <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
                </svg>
                <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
                </svg>
              </button>
            </div>
          </div>

          <a class="btn-primary w-full text-center" href="#contact">
            {nav.discuss}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // Mobile drawer: close on outside click or link click
  const navToggle = document.getElementById('mobile-nav-toggle') as HTMLDetailsElement | null;
  if (navToggle) {
    const summary = navToggle.querySelector('summary');
    navToggle.addEventListener('toggle', () => {
      if (summary) {
        summary.setAttribute('aria-expanded', navToggle.open ? 'true' : 'false');
      }
    });

    navToggle.querySelectorAll('.nav-panel-link, .btn-primary').forEach((link) => {
      link.addEventListener('click', () => {
        navToggle.open = false;
      });
    });
  }

  // Theme toggle button logic (Desktop & Mobile)
  const setupThemeToggle = () => {
    const toggles = [
      document.getElementById('theme-toggle'),
      document.getElementById('theme-toggle-mobile')
    ];

    toggles.forEach((btn) => {
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const nextTheme = isDark ? 'light' : 'dark';

        if (nextTheme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          document.documentElement.setAttribute('data-theme', 'light');
        }

        try {
          localStorage.setItem('theme', nextTheme);
        } catch (e) {
          // ignore
        }
      });
    });
  };

  setupThemeToggle();
</script>