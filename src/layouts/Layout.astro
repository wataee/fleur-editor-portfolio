---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'ru' | 'en' | 'kz' | string;
  canonicalUrl: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  canonicalUrl,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/avatar.jpg',
} = Astro.props;

const siteUrl = 'https://fluere.work';
const ruUrl = `${siteUrl}/ru/`;
const kzUrl = `${siteUrl}/kz/`;
const enUrl = `${siteUrl}/`;
---

<!doctype html>
<html lang={lang} class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="theme-color" content="#0D0E12" />

    <!-- Inline script to immediately set theme before paint and prevent flash -->
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>

    <!-- Hreflang -->
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="kz" href={kzUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={ogTitle} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <ClientRouter />
  </head>
  <body class="bg-bg text-text selection:bg-accent selection:text-white">
    <!-- Subtle Film Grain Overlay -->
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Video Editor Timeline Playhead Progress Bar -->
    <div class="playhead" aria-hidden="true">
      <div class="playhead-fill" id="playhead-fill"></div>
    </div>

    <slot />

    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;
      let activeScrollRaf: number | null = null;

      // Smooth cinematic ease-out curve for anchor navigation: starts immediately and lands softly
      const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

      const handleScrollUpdate = () => {
        const playhead = document.getElementById('playhead-fill');
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;

        if (playhead) {
          playhead.style.setProperty('--playhead', progress.toFixed(4));
        }
      };

      const initLenis = () => {
        if (lenis) {
          lenis.destroy();
          lenis = null;
        }

        // smoothWheel: false ensures the mouse wheel feels 100% natural, instant and responsive without float or delay.
        lenis = new Lenis({
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: false,
          touchMultiplier: 1.0,
          autoRaf: true,
          anchors: false, // We handle smooth anchor navigation via smoothScrollTo
          respectReducedMotion: false,
        });

        (window as any).__lenis = lenis;
        lenis.on('scroll', handleScrollUpdate);
      };

      // Guaranteed smooth scroll engine with zero lag on mouse wheel and flawless anchor animation
      const smoothScrollTo = (target: HTMLElement | number | string, offset = -76, duration = 800) => {
        let targetY = 0;
        if (typeof target === 'number') {
          targetY = target;
        } else if (typeof target === 'string') {
          const el = document.querySelector(target);
          if (!el) return;
          targetY = el.getBoundingClientRect().top + window.scrollY + offset;
        } else if (target instanceof HTMLElement) {
          targetY = target.getBoundingClientRect().top + window.scrollY + offset;
        }

        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        targetY = Math.max(0, Math.min(maxScroll, targetY));

        const startY = window.scrollY;
        const distance = targetY - startY;
        if (Math.abs(distance) < 2) return;

        if (activeScrollRaf !== null) {
          cancelAnimationFrame(activeScrollRaf);
          activeScrollRaf = null;
        }

        const startTime = performance.now();

        // If the user scrolls the wheel or touches the screen during animation, immediately stop smooth scroll so they have full manual control
        const cancelOnUserGesture = () => {
          if (activeScrollRaf !== null) {
            cancelAnimationFrame(activeScrollRaf);
            activeScrollRaf = null;
          }
          window.removeEventListener('wheel', cancelOnUserGesture);
          window.removeEventListener('touchstart', cancelOnUserGesture);
        };

        window.addEventListener('wheel', cancelOnUserGesture, { passive: true, once: true });
        window.addEventListener('touchstart', cancelOnUserGesture, { passive: true, once: true });

        function step(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(1, elapsed / duration);
          const easeProgress = easeOutCubic(progress);

          window.scrollTo(0, startY + distance * easeProgress);

          if (progress < 1) {
            activeScrollRaf = requestAnimationFrame(step);
          } else {
            activeScrollRaf = null;
            window.removeEventListener('wheel', cancelOnUserGesture);
            window.removeEventListener('touchstart', cancelOnUserGesture);
          }
        }

        activeScrollRaf = requestAnimationFrame(step);
      };

      (window as any).__fleurSmoothScrollTo = smoothScrollTo;

      // Universal click interceptor for all buttons & links leading to blocks
      if (!(window as any).__fleurSmoothScrollInit) {
        (window as any).__fleurSmoothScrollInit = true;

        document.addEventListener('click', (e) => {
          const targetEl = e.target as HTMLElement;
          const clickable = targetEl.closest('a[href*="#"], button#to-top, [data-scroll-to]') as HTMLElement | null;
          if (!clickable) return;

          // To Top Button
          if (clickable.id === 'to-top') {
            e.preventDefault();
            smoothScrollTo(0, 0);
            return;
          }

          const scrollToData = clickable.getAttribute('data-scroll-to');
          if (scrollToData) {
            const el = document.querySelector(scrollToData) as HTMLElement | null;
            if (el) {
              e.preventDefault();
              smoothScrollTo(el, -76);
              return;
            }
          }

          const href = clickable.getAttribute('href');
          if (!href) return;

          const hashIdx = href.indexOf('#');
          if (hashIdx === -1) return;

          const pathPart = href.substring(0, hashIdx);
          const hashPart = href.substring(hashIdx);

          if (!hashPart || hashPart === '#') return;

          // Check if link belongs to current page
          const curPath = window.location.pathname.replace(/\/$/, '');
          const linkPath = pathPart.replace(/\/$/, '');

          if (pathPart === '' || linkPath === curPath) {
            e.preventDefault();

            if (hashPart === '#top') {
              smoothScrollTo(0, 0);
              try {
                history.pushState(null, '', window.location.pathname);
              } catch (_) {}
              return;
            }

            const targetSection = document.querySelector(hashPart) as HTMLElement | null;
            if (targetSection) {
              smoothScrollTo(targetSection, -76);
              try {
                history.pushState(null, '', hashPart);
              } catch (_) {}
            }
          }
        }, { capture: true });
      }

      const initReveals = () => {
        setTimeout(() => {
          document.querySelectorAll('.hero [data-reveal]').forEach((el) => {
            el.setAttribute('data-revealed', '1');
          });
        }, 60);

        if ('IntersectionObserver' in window) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.setAttribute('data-revealed', '1');
                  revealObserver.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.08,
              rootMargin: '0px 0px -30px 0px'
            }
          );

          document.querySelectorAll('[data-reveal]:not(.hero [data-reveal])').forEach((el) => {
            revealObserver.observe(el);
          });
        } else {
          document.querySelectorAll('[data-reveal]').forEach((el) => el.setAttribute('data-revealed', '1'));
        }
      };

      // Video Modal Lenis Pause Listeners
      window.addEventListener('fleur:modal-open', () => {
        lenis?.stop();
      });
      window.addEventListener('fleur:modal-close', () => {
        lenis?.start();
      });

      const setupPage = () => {
        initLenis();
        initReveals();
        handleScrollUpdate();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupPage();
        });
      } else {
        setupPage();
      }

      document.addEventListener('astro:page-load', () => {
        setupPage();
      });
    </script>
  </body>
</html>
