---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'ru' | 'en' | 'kz' | string;
  canonicalUrl: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  canonicalUrl,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/avatar.jpg',
} = Astro.props;

const siteUrl = 'https://fluere.work';
const ruUrl = `${siteUrl}/ru/`;
const kzUrl = `${siteUrl}/kz/`;
const enUrl = `${siteUrl}/`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="theme-color" content="#0D0E12" />

    <!-- Inline script to immediately set theme and motion before paint and prevent flash -->
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          document.documentElement.setAttribute('data-theme', 'dark');
        }

        let storedMotion = localStorage.getItem('fleur-motion');
        if (!storedMotion) {
          storedMotion = 'on';
          localStorage.setItem('fleur-motion', 'on');
        }
        document.documentElement.setAttribute('data-motion', storedMotion);
        if (storedMotion === 'on') {
          document.documentElement.classList.add('js-reveal');
        } else {
          document.documentElement.classList.remove('js-reveal');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.setAttribute('data-motion', 'on');
        document.documentElement.classList.add('js-reveal');
      }
    </script>

    <!-- Hreflang -->
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="kz" href={kzUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={ogTitle} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Onest:wght@300;400;500;600;700;800;900&family=Unbounded:wght@400;600;700;800;900&display=swap"
    />


    <!-- Main Stylesheet -->


    <ClientRouter />
    <slot name="head" />

  </head>
  <body class="antialiased selection:bg-accent selection:text-white relative">
    <!-- Film Grain Subtle Texture Overlay -->
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Video Editor Custom Cursor (Desktop Only) -->
    <div class="custom-cursor" id="custom-cursor" aria-hidden="true">
      <div class="cursor-dot"></div>
      <span class="cursor-pill" id="cursor-pill"></span>
    </div>

    <!-- Video Editor Timeline Playhead Progress Bar -->
    <div class="playhead" aria-hidden="true">
      <div class="playhead-fill" id="playhead-fill"></div>
    </div>

    <slot />

    <!-- Scroll To Top Button -->
    <button
      type="button"
      id="to-top"
      class="to-top"
      aria-label={lang === 'kz' ? 'Жоғарыға' : lang === 'ru' ? 'Наверх' : 'To top'}
      data-visible="false"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>

    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;
      let rafId: number | null = null;

      const isFinePointer = window.matchMedia('(pointer: fine)').matches;

      const isMotionActive = () => {
        const motionAttr = document.documentElement.getAttribute('data-motion');
        if (motionAttr === 'on') return true;
        if (motionAttr === 'off') return false;
        return !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      };

      const handleScrollUpdate = () => {
        const playhead = document.getElementById('playhead-fill');
        const toTopBtn = document.getElementById('to-top');

        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;

        if (playhead) {
          playhead.style.setProperty('--playhead', progress.toFixed(4));
        }

        if (toTopBtn) {
          const isScrolled = window.scrollY > window.innerHeight * 0.35;
          toTopBtn.setAttribute('data-visible', isScrolled ? 'true' : 'false');
        }
      };

      const initLenis = () => {
        if (lenis) {
          lenis.destroy();
          lenis = null;
        }
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }

        if (isFinePointer && isMotionActive()) {
          lenis = new Lenis({
            duration: 1.25,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            wheelMultiplier: 1.05,
            touchMultiplier: 1.2,
          });

          const raf = (time: number) => {
            lenis?.raf(time);
            rafId = requestAnimationFrame(raf);
          };
          rafId = requestAnimationFrame(raf);
          lenis.on('scroll', handleScrollUpdate);
        } else {
          window.addEventListener('scroll', handleScrollUpdate, { passive: true });
        }
      };

      const initAnchors = () => {
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (!href || href === '#') return;
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              const headerOffset = 80;

              if (lenis) {
                lenis.scrollTo(target as HTMLElement, {
                  offset: -headerOffset,
                  duration: 1.35,
                  easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
                });
              } else {
                const elementPosition = target.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                window.scrollTo({
                  top: offsetPosition,
                  behavior: isMotionActive() ? 'smooth' : 'auto'
                });
              }

              try {
                history.pushState(null, '', href);
              } catch (_) {}
            }
          });
        });

        const toTopBtn = document.getElementById('to-top');
        if (toTopBtn) {
          toTopBtn.addEventListener('click', () => {
            if (lenis) {
              lenis.scrollTo(0, { duration: 1.2 });
            } else {
              window.scrollTo({ top: 0, behavior: isMotionActive() ? 'smooth' : 'auto' });
            }
          });
        }
      };

      const initReveals = () => {
        if (isMotionActive()) {
          setTimeout(() => {
            document.querySelectorAll('.hero [data-reveal]').forEach((el) => {
              el.setAttribute('data-revealed', '1');
            });
          }, 60);

          if ('IntersectionObserver' in window) {
            const revealObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.setAttribute('data-revealed', '1');
                    revealObserver.unobserve(entry.target);
                  }
                });
              },
              {
                threshold: 0.08,
                rootMargin: '0px 0px -30px 0px'
              }
            );

            document.querySelectorAll('[data-reveal]:not(.hero [data-reveal])').forEach((el) => {
              revealObserver.observe(el);
            });
          } else {
            document.querySelectorAll('[data-reveal]').forEach((el) => el.setAttribute('data-revealed', '1'));
          }
        } else {
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            el.setAttribute('data-revealed', '1');
          });
        }
      };

      const initCustomCursor = () => {
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        const cursor = document.getElementById('custom-cursor');
        const pill = document.getElementById('cursor-pill');

        if (cursor && pill) {
          let mouseX = -100;
          let mouseY = -100;
          let currentX = -100;
          let currentY = -100;

          window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;

            const target = (e.target as HTMLElement)?.closest('[data-cursor], .work-facade, .showreel-monitor, .ba-suite-wrapper');
            if (target) {
              const customLabel = target.getAttribute('data-cursor');
              let activeLabel = 'PLAY';
              if (customLabel) {
                activeLabel = customLabel;
              } else if (target.classList.contains('ba-suite-wrapper')) {
                activeLabel = 'DRAG';
              }
              cursor.classList.add('has-label');
              pill.textContent = activeLabel;
            } else {
              cursor.classList.remove('has-label');
              pill.textContent = '';
            }
          }, { passive: true });

          document.addEventListener('mouseleave', () => {
            mouseX = -100;
            mouseY = -100;
          });

          const renderCursor = () => {
            const ease = 0.16;
            currentX += (mouseX - currentX) * ease;
            currentY += (mouseY - currentY) * ease;
            cursor.style.transform = `translate3d(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px, 0)`;
            requestAnimationFrame(renderCursor);
          };
          requestAnimationFrame(renderCursor);
        }
      };

      const updateMotionState = (state: 'on' | 'off') => {
        document.documentElement.setAttribute('data-motion', state);
        if (state === 'on') {
          document.documentElement.classList.add('js-reveal');
        } else {
          document.documentElement.classList.remove('js-reveal');
        }
        localStorage.setItem('fleur-motion', state);

        document.querySelectorAll('.motion-toggle, .footer-motion-btn').forEach((btn) => {
          btn.setAttribute('aria-pressed', state === 'on' ? 'true' : 'false');
          const txt = btn.querySelector('.motion-state-text');
          if (txt) txt.textContent = state.toUpperCase();
        });

        initLenis();
        if (state === 'off') {
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            el.setAttribute('data-revealed', '1');
          });
        }
      };

      // Video Modal Lenis Pause Listeners
      window.addEventListener('fleur:modal-open', () => {
        lenis?.stop();
      });
      window.addEventListener('fleur:modal-close', () => {
        lenis?.start();
      });

      // Global Motion Toggle Listener
      document.addEventListener('click', (e) => {
        const toggleBtn = (e.target as HTMLElement).closest('#motion-toggle, #motion-toggle-mobile, #motion-toggle-footer, .motion-toggle, .footer-motion-btn');
        if (toggleBtn) {
          e.preventDefault();
          const current = document.documentElement.getAttribute('data-motion') || 'on';
          const next = current === 'on' ? 'off' : 'on';
          updateMotionState(next);
        }
      });

      const setupPage = () => {
        initLenis();
        initAnchors();
        initReveals();
        handleScrollUpdate();
      };

      // Initialize on load and on View Transition page changes
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupPage();
          initCustomCursor();
        });
      } else {
        setupPage();
        initCustomCursor();
      }

      document.addEventListener('astro:page-load', () => {
        setupPage();
      });
    </script>
  </body>
</html>
